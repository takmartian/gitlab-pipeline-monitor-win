<Window x:Class="GitLabPipelineMonitor.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GitLabPipelineMonitor.Converters"
        Title="GitLab Pipeline Monitor"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="Manual" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis2" />

        <!-- 状态图标：运行中的时候要转起来 -->
        <Style x:Key="StatusIconPath" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
            <Setter Property="Data" Value="{Binding Status, Converter={StaticResource StatusToIcon}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="Spin">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 元信息一项：图标 + 文字，允许截断（否则一长就把整行顶出面板） -->
        <DataTemplate x:Key="MetaItem">
            <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                <Path Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"
                      Fill="{StaticResource TertiaryTextBrush}" Data="{Binding Icon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 外面套一层 Border 做描边和阴影，托盘面板要有明确的边界 -->
    <Border BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" CornerRadius="0"
            Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- 底边把手：按住上下拖改面板高度，双击恢复默认 -->
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>

            <!-- ===== 顶栏 ===== -->
            <Grid Grid.Row="0" Background="{StaticResource BarBackgroundBrush}" Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Margin="0,0,9,0"
                        Background="{StaticResource FieldBackgroundBrush}">
                    <Viewbox Width="15" Height="15">
                        <Path Fill="{StaticResource RunningBrush}" Data="{StaticResource Icon.Pipeline}" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderHost}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource PanelForegroundBrush}" />
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="10" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeaderSubtitleIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ProgressBar Grid.Column="2" Width="16" Height="16" Margin="0,0,4,0" IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Visibility="{Binding ShowRefreshIndicator, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="22" Margin="1,0"
                        Click="Refresh_Click" ToolTip="刷新">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Refresh}" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="24" Height="22" Margin="1,0,0,0"
                        Click="Settings_Click" ToolTip="设置">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Settings}" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- ===== 搜索 + 筛选 ===== -->
            <Grid Grid.Row="1" Margin="10,2,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Padding="26,4,22,4"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <Viewbox Width="11" Height="11" HorizontalAlignment="Left" Margin="8,0,0,0">
                        <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Search}" />
                    </Viewbox>
                    <TextBlock Text="搜索 · 项目 / 分支" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TertiaryTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,5,0"
                            Style="{StaticResource IconButton}" Click="ClearSearch_Click" ToolTip="清空">
                        <Viewbox Width="10" Height="10">
                            <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Close}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource FilterChip}" Margin="0,0,5,0"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}" Click="Chip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                                 Fill="{Binding TintHex, Converter={StaticResource HexToBrush}}"
                                                 Visibility="{Binding HasTint, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Viewbox Width="9" Height="9" Margin="0,0,4,0">
                            <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Timer}" />
                        </Viewbox>
                        <TextBlock Text="{Binding TimerLabel}" FontSize="9" Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="{StaticResource HairlineBrush}" />

            <!-- ===== 主体：分组列表 ===== -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="8,6" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,2">

                                <!-- 项目头 -->
                                <Grid Height="34" x:Name="ProjectHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="16" Height="16"
                                            Margin="2,0,4,0" Click="ToggleCollapse_Click" Tag="{Binding Project.Id}">
                                        <Viewbox Width="8" Height="8">
                                            <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.ChevronDown}" />
                                        </Viewbox>
                                    </Button>

                                    <Viewbox Grid.Column="1" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding Starred, Converter={StaticResource BoolToVis}}">
                                        <Path Fill="{StaticResource StarBrush}" Data="{StaticResource Icon.Star}" />
                                    </Viewbox>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PanelForegroundBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Height="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TertiaryTextBrush}"
                                                   Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Border Grid.Column="3" CornerRadius="4" Padding="4,1" Margin="4,0" VerticalAlignment="Center"
                                            Background="{StaticResource FieldBackgroundBrush}"
                                            Visibility="{Binding ShowArchived, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="归档" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Path Width="11" Height="11" Margin="0,0,4,0" Style="{StaticResource StatusIconPath}"
                                              DataContext="{Binding Latest}" />
                                        <TextBlock Text="{Binding LatestTime}" FontSize="9"
                                                   Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="20" Height="18"
                                            Click="StarProject_Click" Tag="{Binding Project.Id}" ToolTip="打星 / 取消打星">
                                        <Viewbox Width="10" Height="10">
                                            <Path Fill="{StaticResource StarBrush}" Data="{StaticResource Icon.StarOutline}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Width="20" Height="18"
                                            Click="RunPipeline_Click" Tag="{Binding Project.Id}" ToolTip="运行新流水线">
                                        <Viewbox Width="11" Height="11">
                                            <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Play}" />
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!-- 流水线行 -->
                                <ItemsControl ItemsSource="{Binding Pipelines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Click="OpenPipeline_Click"
                                                    Tag="{Binding Id}" HorizontalContentAlignment="Stretch"
                                                    ContextMenuService.IsEnabled="True">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="详情" Click="MenuDetail_Click" />
                                                        <MenuItem Header="在项目页打开" Click="MenuOpenPipeline_Click" />
                                                        <Separator />
                                                        <MenuItem Header="重试" Click="MenuRetry_Click" />
                                                        <MenuItem Header="取消" Click="MenuCancel_Click" />
                                                        <Separator />
                                                        <MenuItem Header="复制分支名" Click="MenuCopyRef_Click" />
                                                        <MenuItem Header="复制提交 SHA" Click="MenuCopySha_Click" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path Grid.Column="0" Width="13" Height="13" Style="{StaticResource StatusIconPath}" />

                                                    <StackPanel Grid.Column="1" Margin="6,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Branch}" />
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding Ref}" FontSize="11.5" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                                       Foreground="{StaticResource PanelForegroundBrush}" />
                                                            <TextBlock Text="{Binding Iid, StringFormat=#{0}}" FontSize="10"
                                                                       Margin="6,0,0,0" Foreground="{StaticResource TertiaryTextBrush}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="10" Margin="6,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="90"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                                                                <Viewbox Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                                                    <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Box}" />
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding ShortSha}" FontSize="10"
                                                                           Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                                                                <Viewbox Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                                                    <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Clock}" />
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding RelativeTime}" FontSize="10"
                                                                           Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,9,0"
                                                                          Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                                                <Viewbox Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                                                    <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Stopwatch}" />
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding DurationText}" FontSize="10"
                                                                           Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,9,0"
                                                                          Visibility="{Binding HasCoverage, Converter={StaticResource BoolToVis}}">
                                                                <Viewbox Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                                                    <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Seal}" />
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding Coverage}" FontSize="10"
                                                                           Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal"
                                                                          Visibility="{Binding HasUser, Converter={StaticResource BoolToVis}}">
                                                                <Viewbox Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                                                    <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Person}" />
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding UserName}" FontSize="10"
                                                                           Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 右侧：平时显示状态文字，悬停换成操作按钮 -->
                                                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="52">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                                   HorizontalAlignment="Right" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    Visibility="Collapsed" x:Name="RowActions">
                                                            <Button Style="{StaticResource IconButton}" Width="22" Height="20"
                                                                    Click="RetryRow_Click" Tag="{Binding Id}" ToolTip="重试">
                                                                <Viewbox Width="11" Height="11">
                                                                    <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Refresh}" />
                                                                </Viewbox>
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Width="22" Height="20"
                                                                    Click="CancelRow_Click" Tag="{Binding Id}" ToolTip="取消">
                                                                <Viewbox Width="10" Height="10">
                                                                    <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Stop}" />
                                                                </Viewbox>
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Width="22" Height="20"
                                                                    Click="OpenPipeline_Click" Tag="{Binding Id}" ToolTip="详情">
                                                                <Viewbox Width="9" Height="9">
                                                                    <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.ChevronRight}" />
                                                                </Viewbox>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="RowActions" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 该项目的加载错误 -->
                                <StackPanel Orientation="Horizontal" Margin="30,2,6,4"
                                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                                    <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                                        <Path Fill="{StaticResource BlockedBrush}" Data="{StaticResource Icon.Alert}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Error}" FontSize="10" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="30,2,0,0" Opacity="0.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== 空状态 ===== -->
            <Grid Grid.Row="3" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" Margin="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Path Fill="{StaticResource TertiaryTextBrush}"
                              Data="{Binding EmptyIconKey, Converter={x:Static conv:IconResourceConverter.Instance}}" />
                    </Viewbox>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{StaticResource PanelForegroundBrush}" />
                    <TextBlock Text="{Binding EmptyMessage}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,6,0,0" MaxWidth="280" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Button Content="{Binding EmptyAction}" Height="24" MinWidth="80" Margin="0,10,0,0"
                            HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                            Click="EmptyAction_Click" Visibility="{Binding EmptyAction, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Height="1" Background="{StaticResource HairlineBrush}" />

            <!-- ===== 底栏 ===== -->
            <Grid Grid.Row="5" Background="{StaticResource BarBackgroundBrush}" Margin="10,6" Height="26">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                        <Path Fill="{StaticResource TertiaryTextBrush}" Data="{StaticResource Icon.Clock}" />
                    </Viewbox>
                    <TextBlock Text="{Binding FooterUpdated}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding FooterSummary}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TertiaryTextBrush}" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="22" HorizontalAlignment="Right"
                        Click="OpenGitLab_Click" ToolTip="打开 GitLab">
                    <Viewbox Width="11" Height="11">
                        <Path Fill="{StaticResource PanelForegroundBrush}" Data="{StaticResource Icon.Open}" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- 底边拖拽把手：平时看不见，鼠标移上去显出一条短线提示 -->
            <Border Grid.Row="6" x:Name="ResizeGrip" Background="Transparent" Cursor="SizeNS"
                    MouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove"
                    MouseLeftButtonUp="Grip_MouseUp" MouseLeave="Grip_MouseLeave"
                    ToolTip="拖动底边调整高度，双击恢复默认">
                <Border x:Name="GripMark" Width="34" Height="3" CornerRadius="2" Opacity="0"
                        Background="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </Border>

            <!-- 覆盖层：流水线详情 / 运行流水线 -->
            <Grid x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="7" Background="{StaticResource PanelBackgroundBrush}"
                  Visibility="Collapsed" />

            <!-- 操作反馈 toast -->
            <Border x:Name="ToastHost" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,8"
                    CornerRadius="8" Padding="10,7" Background="{StaticResource BarBackgroundBrush}"
                    BorderThickness="0.5" BorderBrush="{StaticResource HairlineBrush}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                        <Path x:Name="ToastIcon" Fill="{StaticResource FailedBrush}" Data="{StaticResource Icon.Alert}" />
                    </Viewbox>
                    <TextBlock x:Name="ToastText" FontSize="11" MaxWidth="300" TextWrapping="Wrap"
                               Foreground="{StaticResource PanelForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
