<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 状态色：取值与 macOS 版逐一对齐，两端看到的颜色应当一致 -->
    <Color x:Key="SuccessColor">#FF33B85C</Color>
    <Color x:Key="FailedColor">#FFF04545</Color>
    <Color x:Key="RunningColor">#FF388CFA</Color>
    <Color x:Key="PendingColor">#FFF5A624</Color>
    <Color x:Key="CanceledColor">#FF8C949E</Color>
    <Color x:Key="ManualColor">#FF9E73E6</Color>
    <Color x:Key="BlockedColor">#FFD97333</Color>
    <Color x:Key="MutedColor">#FF8E8E93</Color>
    <Color x:Key="StarColor">#FFF5B833</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="FailedBrush" Color="{StaticResource FailedColor}" />
    <SolidColorBrush x:Key="RunningBrush" Color="{StaticResource RunningColor}" />
    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource PendingColor}" />
    <SolidColorBrush x:Key="CanceledBrush" Color="{StaticResource CanceledColor}" />
    <SolidColorBrush x:Key="ManualBrush" Color="{StaticResource ManualColor}" />
    <SolidColorBrush x:Key="BlockedBrush" Color="{StaticResource BlockedColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="StarBrush" Color="{StaticResource StarColor}" />

    <!-- 面板底色：跟随系统的明暗主题（WPF 在 Win10/11 上默认是浅色，
         这里用系统颜色键，至少保证与系统一致而不是硬编码白底） -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="BarBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Opacity="0.62" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Opacity="0.45" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="RowHoverBrush" Opacity="0.055" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Opacity="0.06" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="HairlineBrush" Opacity="0.12" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

</ResourceDictionary>
