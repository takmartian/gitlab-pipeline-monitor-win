<Window x:Class="GitLabPipelineMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitLabPipelineMonitor.Views"
        Title="设置" Width="620" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBackgroundBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" FontSize="12">

    <!-- 设置窗口用 Windows 原生控件（TabControl / CheckBox / ComboBox / Slider / TextBox），
         只借 macOS 版的信息层次（分组卡片 + 分组标题 + 说明文字），不做自绘的 mac 风格。
         静态文案通过 loc:LocalizedText.Source 写中文原文，由 code-behind 取译文并在语言切换时重刷。 -->
    <Window.Resources>
        <!-- 下拉项的显示模板：只显示 Text 属性。
             之前用的是 DisplayMemberPath="Text"，但实测它在这套用法下根本没生成模板
             （ItemTemplate / SelectionBoxItemTemplate 都是 null），下拉框里显示的
             是一长串 CLR 类型名。显式给 ItemTemplate 之后，ComboBox 会把它
             同步给 SelectionBoxItemTemplate，选中框和下拉项都走这一个模板；
             而且 Text 变了绑定会自动更新，语言切换不用额外刷新。 -->
        <DataTemplate x:Key="OptionText">
            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource PanelForegroundBrush}" />
        </DataTemplate>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="10,10,10,10" BorderThickness="0" Background="Transparent"
                TextElement.Foreground="{DynamicResource PanelForegroundBrush}"
                SelectionChanged="Tabs_SelectionChanged">

        <!-- ==================== 连接 ==================== -->
        <TabItem loc:LocalizedText.Source="连接">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                <StackPanel Margin="14,2,18,12">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="服务器地址" />
                            <Grid>
                                <TextBox x:Name="ServerBox" Style="{StaticResource FieldInput}"
                                         TextChanged="ServerBox_TextChanged"
                                         Text="{Binding Settings.ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="ServerPlaceholder" IsHitTestVisible="False" Margin="9,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           loc:LocalizedText.Source="例如 https://gitlab.example.com" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           loc:LocalizedText.Source="令牌类型" />
                                <ComboBox x:Name="AuthModeBox" Grid.Column="1" Height="26"
                                          ItemTemplate="{StaticResource OptionText}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.AuthMode}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           loc:LocalizedText.Source="访问令牌" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TokenBox" Style="{StaticResource FieldInput}" Visibility="Collapsed"
                                             Text="{Binding Settings.Token, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox x:Name="TokenHidden" Height="28" VerticalContentAlignment="Center"
                                                 Padding="7,0" FontSize="12" PasswordChanged="TokenHidden_Changed" />
                                    <TextBlock x:Name="TokenPlaceholder" IsHitTestVisible="False" Margin="9,0,0,0"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               loc:LocalizedText.Source="粘贴令牌" />
                                </Grid>
                                <Button x:Name="RevealButton" Grid.Column="2" Width="58" Height="26" Margin="6,0,0,0"
                                        Click="Reveal_Click" />
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       loc:LocalizedText.Source="令牌在本机加密保存（AES-GCM，密钥来自这台电脑和你的登录账户），不会写进配置文件。" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                                    <Hyperlink x:Name="CreateTokenLink" Click="CreateToken_Click">
                                        <Run x:Name="CreateTokenRun" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           loc:LocalizedText.Source="令牌需要 read_api 权限；若还要读取未加入的项目，请加上 read_user。" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="测试连接" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TestButton" MinWidth="116" Height="26" Click="Test_Click" />
                                <Button x:Name="ReloadButton" MinWidth="150" Height="26" Margin="10,0,0,0"
                                        Click="Reload_Click" />
                            </StackPanel>

                            <StackPanel x:Name="TestResultRow" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path x:Name="TestStatusIcon" Fill="{DynamicResource SuccessBrush}" />
                                </Viewbox>
                                <TextBlock x:Name="TestStatusText" VerticalAlignment="Center" FontSize="12"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid x:Name="TestInfoPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyText}"
                                           loc:LocalizedText.Source="服务器" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                                           x:Name="InfoServerValue" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyText}"
                                           loc:LocalizedText.Source="登录用户" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"
                                           x:Name="InfoUserValue" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyText}"
                                           loc:LocalizedText.Source="GitLab 版本" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}"
                                           x:Name="InfoVersionValue" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyText}"
                                           loc:LocalizedText.Source="项目" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}"
                                           x:Name="InfoProjectsValue" />
                            </Grid>

                            <TextBox x:Name="TestErrorText" IsReadOnly="True" BorderThickness="0" Margin="0,8,0,0"
                                     Background="Transparent" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed"
                                     Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                            <Path Fill="{DynamicResource TertiaryTextBrush}" Data="{StaticResource Icon.CheckCircle}" />
                        </Viewbox>
                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   loc:LocalizedText.Source="改动即时生效，无需保存。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 项目 ==================== -->
        <TabItem loc:LocalizedText.Source="项目">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                <StackPanel Margin="14,2,18,12">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="OnlyStarredBox" loc:LocalizedText.Source="仅监控星标项目"
                                      IsChecked="{Binding Settings.OnlyStarred}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       loc:LocalizedText.Source="开启后只监控你打过星的项目；关闭后可在下方手动勾选。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="项目" />

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource StarBrush}" Data="{StaticResource Icon.Star}" />
                                    </Viewbox>
                                    <TextBlock x:Name="StarCountText" Style="{StaticResource CountText}" />
                                    <TextBlock Text="·" Style="{StaticResource CountText}" Margin="7,0" />
                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource TertiaryTextBrush}" Data="{StaticResource Icon.Person}" />
                                    </Viewbox>
                                    <TextBlock x:Name="MemberCountText" Style="{StaticResource CountText}" />
                                    <TextBlock Text="·" Style="{StaticResource CountText}" Margin="7,0" />
                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource TertiaryTextBrush}" Data="{StaticResource Icon.Tray}" />
                                    </Viewbox>
                                    <TextBlock x:Name="MonitoredCountText" Style="{StaticResource CountText}" />
                                    <TextBlock x:Name="LoadingMembersText" Style="{StaticResource CountText}"
                                               Margin="10,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel x:Name="PickButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SelectAllButton" Height="22" Padding="8,0" Click="SelectAll_Click" />
                                    <Button x:Name="ClearButton" Height="22" Padding="8,0" Margin="6,0,0,0"
                                            Click="Clear_Click" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,8,0,0">
                                <Border Background="{DynamicResource FieldBackgroundBrush}" CornerRadius="6"
                                        BorderThickness="0.5" BorderBrush="{DynamicResource HairlineBrush}" Height="26">
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                                 TextChanged="SearchBox_TextChanged" />
                                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                                   loc:LocalizedText.Source="搜索" />
                                        <Viewbox Width="12" Height="12" Margin="0,0,8,0" HorizontalAlignment="Right">
                                            <Path Fill="{DynamicResource TertiaryTextBrush}"
                                                  Data="{StaticResource Icon.Search}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="SelectedCountText" Style="{StaticResource CountText}"
                                       Margin="0,8,0,0" HorizontalAlignment="Left" />

                            <Border Margin="0,8,0,0" Height="210" CornerRadius="6" BorderThickness="0.5"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    Background="{DynamicResource FieldBackgroundBrush}">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                                        <ItemsControl x:Name="ProjectList"
                                                      ItemsSource="{Binding ProjectRows, Mode=OneTime}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,1" Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                                                Width="22" Height="22" Click="StarRow_Click"
                                                                ToolTip="{Binding StarTip}">
                                                            <Viewbox Width="12" Height="12">
                                                                <!-- 几何在 24x24 视图里，必须用 Viewbox 缩到 12x12：
                                                                     直接把 Path 放进 Grid 的话，Grid 的隐式列会按几何的
                                                                     原始尺寸（20x19）撑开，Path 就按原尺寸画并溢出、被裁掉，
                                                                     星形只剩左上角一块。 -->
                                                                <Grid>
                                                                    <Path Fill="{DynamicResource StarBrush}"
                                                                          Data="{StaticResource Icon.Star}"
                                                                          Visibility="{Binding Starred, Converter={StaticResource BoolToVis}}" />
                                                                    <Path Fill="{DynamicResource TertiaryTextBrush}"
                                                                          Data="{StaticResource Icon.StarOutline}"
                                                                          Visibility="{Binding Starred, Converter={StaticResource InvBoolToVis}}" />
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NamespaceText}" FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                                                       Visibility="{Binding ShowNamespace, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="3" Padding="4,1"
                                                                Margin="4,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource HairlineBrush}"
                                                                Visibility="{Binding Archived, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding ArchivedLabel}" FontSize="9"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="10"
                                                                   VerticalAlignment="Center" Margin="4,0"
                                                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                                                   Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" />
                                                        <ProgressBar Grid.Column="4" Width="22" Height="3"
                                                                     IsIndeterminate="True" VerticalAlignment="Center"
                                                                     Margin="4,0"
                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                                        <CheckBox Grid.Column="5" IsChecked="{Binding Monitored, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" Margin="4,0"
                                                                  Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}" />
                                                        <Button Grid.Column="6" Style="{StaticResource IconButton}"
                                                                Width="22" Height="22" Click="OpenRow_Click"
                                                                ToolTip="{Binding OpenTip}">
                                                            <Viewbox Width="11" Height="11">
                                                                <Path Fill="{DynamicResource TertiaryTextBrush}"
                                                                      Data="{StaticResource Icon.Open}" />
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel x:Name="ProjectEmptyState" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" MaxWidth="360" Margin="16">
                                        <Viewbox Width="34" Height="34" Margin="0,0,0,10">
                                            <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource Icon.Box}" />
                                        </Viewbox>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" TextAlignment="Center"
                                                   loc:LocalizedText.Source="还没有项目" />
                                        <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,4,0,8"
                                                   loc:LocalizedText.Source="先在「连接」里填好地址和令牌，再点「重新拉取项目列表」；列表出来后点行首的星标就能打星。" />
                                        <Button x:Name="EmptyReloadButton" Height="24" HorizontalAlignment="Center"
                                                Click="Reload_Click" loc:LocalizedText.Source="重新拉取项目列表" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="LoadedSummaryText" Style="{StaticResource CountText}"
                                       Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="每个项目显示的流水线数" />
                            <Slider x:Name="PipelinesSlider" Minimum="1" Maximum="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,6,0,0"
                                    Value="{Binding Settings.PipelinesPerProject}" />
                            <TextBlock x:Name="PipelineCountText" Style="{StaticResource CountText}"
                                       Margin="0,4,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 通用 ==================== -->
        <TabItem loc:LocalizedText.Source="通用">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                <StackPanel Margin="14,2,18,12">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="通用" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           loc:LocalizedText.Source="语言" />
                                <ComboBox x:Name="LanguageBox" Grid.Row="0" Grid.Column="1" Height="26" HorizontalAlignment="Left"
                                          MinWidth="180" ItemTemplate="{StaticResource OptionText}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Language}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                           loc:LocalizedText.Source="自动刷新" />
                                <ComboBox x:Name="RefreshBox" Grid.Row="1" Grid.Column="1" Height="26" HorizontalAlignment="Left"
                                          MinWidth="180" Margin="0,8,0,0" ItemTemplate="{StaticResource OptionText}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.RefreshInterval}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                           loc:LocalizedText.Source="面板宽度" />
                                <ComboBox x:Name="WidthBox" Grid.Row="2" Grid.Column="1" Height="26" HorizontalAlignment="Left"
                                          MinWidth="180" Margin="0,8,0,0" ItemTemplate="{StaticResource OptionText}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.PanelWidth}" />

                                <CheckBox x:Name="RefreshOnOpenBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                                          loc:LocalizedText.Source="打开面板时自动刷新" IsChecked="{Binding Settings.RefreshOnOpen}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="托盘图标" />
                            <CheckBox loc:LocalizedText.Source="托盘图标显示状态" IsChecked="{Binding Settings.ShowStatusBadge}" />
                            <CheckBox loc:LocalizedText.Source="显示失败数量" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.ShowFailureCount}"
                                      IsEnabled="{Binding Settings.ShowStatusBadge}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" loc:LocalizedText.Source="更新" />
                            <CheckBox loc:LocalizedText.Source="自动检查更新" IsChecked="{Binding Settings.AutoUpdateEnabled}" />
                            <TextBlock Style="{StaticResource HintText}" FontSize="10" Margin="0,6,0,0"
                                       loc:LocalizedText.Source="开启后每天自动检查一次，发现新版本会弹窗展示更新内容，由你决定立即更新还是忽略此版本。" />
                            <StackPanel x:Name="IgnoredUpdateRow" Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="IgnoredUpdateText" Style="{StaticResource CountText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Button x:Name="UnignoreButton" Height="22" Padding="8,0" Margin="10,0,0,0"
                                        Click="Unignore_Click" loc:LocalizedText.Source="取消忽略" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox loc:LocalizedText.Source="流水线失败时通知" IsChecked="{Binding Settings.NotifyOnFailure}" />
                            <CheckBox loc:LocalizedText.Source="流水线恢复时通知" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.NotifyOnRecovery}" />
                            <StackPanel x:Name="NotifyHintRow" Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                <Viewbox Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource TertiaryTextBrush}" Data="{StaticResource Icon.BellOff}" />
                                </Viewbox>
                                <TextBlock Style="{StaticResource HintText}" MaxWidth="420" HorizontalAlignment="Left"
                                           loc:LocalizedText.Source="通知已在系统设置中关闭，Windows 一般不会拦截托盘气泡，但专注 assist 状态可能不显示。" />
                            </StackPanel>
                            <CheckBox x:Name="LaunchBox" loc:LocalizedText.Source="登录时启动" Margin="0,8,0,0"
                                      Checked="Launch_Changed" Unchecked="Launch_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 关于 ==================== -->
        <TabItem loc:LocalizedText.Source="关于">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                <StackPanel Margin="24,10,24,12">
                    <!-- 用矢量 logo（Theme/Logo.xaml）：直接引 app.ico 的话，
                         WPF 只会解出第一帧 16×16，放大到 72 DIP 就是马赛克 -->
                    <Image Source="{StaticResource Logo.Image}" Width="72" Height="72" HorizontalAlignment="Center"
                           Margin="0,6,0,10" />
                    <TextBlock x:Name="AboutNameText" FontSize="17" FontWeight="Bold" TextAlignment="Center"
                               Foreground="{DynamicResource PanelForegroundBrush}" />
                    <TextBlock x:Name="AboutVersionText" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock x:Name="UpdateStatusText" FontSize="11" VerticalAlignment="Center"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button x:Name="CheckUpdateButton" Height="24" Padding="10,0" Margin="12,0,0,0"
                                Click="CheckUpdate_Click" loc:LocalizedText.Source="检查更新" />
                        <Button x:Name="UpdateNowButton" Height="24" Padding="10,0" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="UpdateNow_Click" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,10,0,0"
                               loc:LocalizedText.Source="原生 WPF + Win32 托盘应用，无 Electron、无外部依赖。" />

                    <Grid Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyText}" Margin="0,0,12,3"
                                   loc:LocalizedText.Source="服务器" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutServerValue" Style="{StaticResource ValueText}"
                                   Margin="0,0,0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyText}" Margin="0,0,12,0"
                                   loc:LocalizedText.Source="项目" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutProjectsValue" Style="{StaticResource ValueText}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Height="26" Padding="10,0" Click="CopyDiagnostics_Click"
                                loc:LocalizedText.Source="复制诊断信息" />
                        <Button Height="26" Padding="10,0" Margin="10,0,0,0" Click="ShowInExplorer_Click"
                                loc:LocalizedText.Source="在资源管理器中显示" />
                        <Button Height="26" Padding="10,0" Margin="10,0,0,0" Click="ProjectHome_Click"
                                loc:LocalizedText.Source="项目主页" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
