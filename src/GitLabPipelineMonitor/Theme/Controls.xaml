<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GitLabPipelineMonitor.Converters">

    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    <conv:StatusToIconConverter x:Key="StatusToIcon" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <conv:StringToVisibilityConverter x:Key="StrToVis" />
    <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
    <conv:PositiveCountToVisibilityConverter x:Key="CountToVis" />
    <conv:BrushOpacityConverter x:Key="BrushOpacity" />

    <!-- 小图标按钮：平时是普通图标，悬停出现圆角底。
         尺寸固定，出现底时不会把行高撑开（这是 macOS 版踩过的坑）。 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="5"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 筛选胶囊：标题可以被截断，但计数必须完整可见 -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" CornerRadius="11" Padding="9,3" BorderThickness="0.5"
                            Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <!-- 选中态用系统强调色底 + 描边，符合 Windows 原生观感 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索框：自己画底和描边，占位文字用 Tag 传（WPF 原生 TextBox 没有占位符）。

         三个坑都是实测出来的（artifacts/caretprobe 能复现，1 DIP = 200% 缩放下 2 设备像素）：

         1) 自定义模板里 TextBox 的 Padding 会被套两次：
            WPF 自己会把 Padding 套到文字宿主上，模板再给内容宿主写
            Margin="{TemplateBinding Padding}" 就是第二遍 —— Padding=26 文字从 52 DIP 开始。
            原来模板写死 Margin="6,4"，面板那个 Padding="26,4,22,4"（给左放大镜、右清除按钮留位）
            被整个吃掉，光标贴在最左边，跟占位文字差 8 DIP，一输入字就压在放大镜上。
            所以内容宿主这里不能给 Margin，让 WPF 自己套那一次就够。

         2) WPF 的文字宿主自带 2 DIP 左内缩，占位文字是另一个元素，对不上。
            内容宿主往左挪 2 DIP（Margin="-2,0,0,0"）把这 2 DIP 抵消掉，
            占位文字就能用同一套 Padding 定位，跟正文完全重合。

         3) 占位文字必须画在模板里：放在外面当兄弟节点的话，
            要同时对上 TextBox 的内边距和外面那个 TextBlock 的边距，
            差半像素在 200% 缩放下就是 1 个设备像素。 -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{DynamicResource FieldBackgroundBrush}" CornerRadius="7"
                            BorderThickness="0.5" BorderBrush="{DynamicResource HairlineBrush}">
                        <Grid>
                            <!-- 内容宿主不能给 Margin（Padding 会被套两次，见上面第 1 条）；
                                 -2 是抵消文字宿主自带的 2 DIP 左内缩，见第 2 条 -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0,0,0" VerticalAlignment="Center" />
                            <!-- 占位文字：内容取自 Tag，文本框为空时才显示 -->
                            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 整行可点的按钮（流水线行、项目头）：悬停出现淡底 -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置页的分组卡片 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,7" />
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!-- 继承隐式 TextBox 样式（Widgets.xaml 里的 Win11 外壳），只覆盖这几项；
         不继承的话它会用 WPF 自带的浅色模板，深色主题下就是一块白。 -->
    <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 主按钮：用系统强调色，Windows 原生观感 -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 空状态：图标 + 标题 + 说明 + 可选按钮 -->
    <Style x:Key="EmptyIcon" TargetType="Path">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource TertiaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

</ResourceDictionary>
