<UserControl x:Class="GitLabPipelineMonitor.PipelineDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- 作业状态图标：与面板行同款语义（运行中转圈）。
             RenderTransform 要先给一个 RotateTransform，动画才有目标。 -->
        <Style x:Key="JobStatusIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
            <Setter Property="Data" Value="{Binding Status, Converter={StaticResource StatusToIcon}}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="JobSpin">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="JobSpin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 作业行：状态图标 + 名称 + 允许失败标记 + 失败原因；右侧耗时 / 转圈，悬停出操作按钮 -->
        <DataTemplate x:Key="JobTemplate">
            <Grid Background="Transparent" Margin="0,1" ToolTip="{Binding Tooltip}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding MenuViewLog}" Click="OpenJob_Click"
                                  Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding MenuRetryJob}" Click="RetryJob_Click"
                                  Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding MenuCancelJob}" Click="CancelJob_Click"
                                  Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="11" Height="11" Style="{StaticResource JobStatusIcon}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                   Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                        <Border Margin="5,0,0,0" CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                Background="{DynamicResource FieldBackgroundBrush}"
                                Visibility="{Binding ShowAllowFailure, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AllowFailureLabel}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FailureReasonText}" FontSize="9" Foreground="{DynamicResource FailedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               Visibility="{Binding HasFailure, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="46">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DurationText}" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Width="12" Height="12" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,2,0"
                                     Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                        <StackPanel x:Name="JobActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Style="{StaticResource IconButton}" Width="20" Height="18" Margin="1,0"
                                    Click="RetryJob_Click" Tag="{Binding}" ToolTip="{Binding TipRetry}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="10" Height="10">
                                    <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Refresh}" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="20" Height="18" Margin="1,0"
                                    Click="CancelJob_Click" Tag="{Binding}" ToolTip="{Binding TipCancel}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="10" Height="10">
                                    <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Stop}" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="20" Height="18" Margin="1,0,0,0"
                                    Click="OpenJob_Click" Tag="{Binding}" ToolTip="{Binding TipOpen}"
                                    Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="10" Height="10">
                                    <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Open}" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="JobActions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- stage 分组：组名 + 组内作业 -->
        <DataTemplate x:Key="StageTemplate">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TertiaryTextBrush}" Margin="5,0,0,3" />
                <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource JobTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏：返回 + 标题 + 状态 ===== -->
        <Grid Grid.Row="0" Background="{DynamicResource BarBackgroundBrush}" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Grid.Column="0" Style="{StaticResource IconButton}" Width="24" Height="22"
                    HorizontalAlignment="Left" Click="Back_Click">
                <Viewbox Width="12" Height="12">
                    <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.ChevronRight}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="180" />
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>
            </Button>

            <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PanelForegroundBrush}" />
                <TextBlock x:Name="PathText" FontSize="9" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TertiaryTextBrush}" />
            </StackPanel>

            <Path x:Name="HeaderStatusIcon" Grid.Column="2" Width="15" Height="15" Stretch="Uniform"
                  VerticalAlignment="Center" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="HeaderText" Grid.Column="3" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource HairlineBrush}" />

        <!-- ===== 主体：概要 / 提交信息 / 作业 ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
            <StackPanel>

                <!-- 概要 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="SummaryTitle" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 分支 -->
                            <TextBlock x:Name="KeyBranch" Grid.Row="0" Grid.Column="0" FontSize="10" Margin="0,3"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True">
                                <Button x:Name="CopyRefBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Width="18" Height="16" Click="CopyRef_Click">
                                    <Viewbox Width="9" Height="9">
                                        <Path Fill="{DynamicResource TertiaryTextBrush}" Data="{StaticResource Icon.Copy}" />
                                    </Viewbox>
                                </Button>
                                <TextBlock x:Name="ValRef" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- 提交 -->
                            <TextBlock x:Name="KeyCommit" Grid.Row="1" Grid.Column="0" FontSize="10" Margin="0,3"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ValSha" Grid.Row="1" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New" Foreground="{DynamicResource PanelForegroundBrush}" />

                            <!-- 名称 -->
                            <Grid x:Name="RowName" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyName" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValName" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 触发方式 -->
                            <Grid x:Name="RowSource" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeySource" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValSource" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 作者（触发人） -->
                            <Grid x:Name="RowUser" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyUser" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValUser" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 耗时 -->
                            <Grid x:Name="RowDuration" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyDuration" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValDuration" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 开始时间 -->
                            <Grid x:Name="RowStarted" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyStarted" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValStarted" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 结束时间 -->
                            <Grid x:Name="RowFinished" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyFinished" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValFinished" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 创建时间 -->
                            <Grid x:Name="RowCreated" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyCreated" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValCreated" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 更新时间 -->
                            <Grid x:Name="RowUpdated" Grid.Row="9" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyUpdated" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValUpdated" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 覆盖率 -->
                            <Grid x:Name="RowCoverage" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="KeyCoverage" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValCoverage" Grid.Column="1" FontSize="11"
                                           Foreground="{DynamicResource PanelForegroundBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 提交信息 -->
                <Border x:Name="CommitCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CommitTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="CommitTitleText" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PanelForegroundBrush}" />
                        <TextBlock x:Name="CommitAuthor" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="CommitTime" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 作业 -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="JobsTitle" Style="{StaticResource SectionTitle}" />

                        <StackPanel x:Name="JobsLoading" Orientation="Horizontal" Margin="5,2" Visibility="Collapsed">
                            <ProgressBar Width="14" Height="14" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="JobsLoadingText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid x:Name="JobsErrorPanel" Margin="5,2" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="10" Height="10" Margin="0,2,5,0" VerticalAlignment="Top">
                                <Path Fill="{DynamicResource BlockedBrush}" Data="{StaticResource Icon.Alert}" />
                            </Viewbox>
                            <TextBlock x:Name="JobsErrorText" Grid.Column="1" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button x:Name="JobsRetryBtn" Grid.Column="2" FontSize="11" Padding="8,2" Margin="6,0,0,0"
                                    VerticalAlignment="Top" Click="RetryJobs_Click" />
                        </Grid>

                        <TextBlock x:Name="JobsEmpty" FontSize="11" Margin="5,2" Visibility="Collapsed"
                                   Foreground="{DynamicResource TertiaryTextBrush}" />

                        <ItemsControl x:Name="JobsList" ItemTemplate="{StaticResource StageTemplate}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Height="1" Background="{DynamicResource HairlineBrush}" />

        <!-- ===== 底部操作 ===== -->
        <Grid Grid.Row="4" Background="{DynamicResource BarBackgroundBrush}" Margin="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RetryBtn" FontSize="11" Padding="8,3" Click="RetryPipeline_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                            <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Refresh}" />
                        </Viewbox>
                        <TextBlock x:Name="RetryBtnText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" FontSize="11" Padding="8,3" Margin="6,0,0,0" Click="CancelPipeline_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                            <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Stop}" />
                        </Viewbox>
                        <TextBlock x:Name="CancelBtnText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="PipelineBusyIndicator" Width="14" Height="14" IsIndeterminate="True"
                             Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="OpenBtn" HorizontalAlignment="Right" FontSize="11" Padding="8,3" Click="OpenPipelinePage_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                        <Path Fill="{DynamicResource PanelForegroundBrush}" Data="{StaticResource Icon.Open}" />
                    </Viewbox>
                    <TextBlock x:Name="OpenBtnText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
