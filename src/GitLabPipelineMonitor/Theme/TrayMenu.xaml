<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Win11 风格的 WPF 右键菜单（隐式样式，全应用生效）：面板/详情页里的
         WPF ContextMenu（PipelineDetailView 作业行、PanelWindow 流水线行）都用这套观感。
         托盘右键菜单不走隐式样式 —— 它用下面带 x:Key 的 TrayMenuStyle / TrayMenuItemStyle，
         那套是照着 Win11 飞层菜单（Windows 安全中心那种）单独画的。
         颜色全部引用 Colors.xaml 的语义画刷：ThemeManager 切主题时直接改写这些画刷对象，
         菜单无需重新加载就自动变色，这里不写死任何主题色字面量。
         样式只针对 ContextMenu / MenuItem / Separator 三种类型本身，
         不碰 Header 里的内容模板，菜单项里绑定的作业名等照常显示。 -->

    <!-- 外框：圆角卡片 + 1px 描边 + 柔和阴影。
         Border 外留 10 的 Margin 是给阴影留的扩散空间：Popup 会裁剪自己的边界，
         阴影画在边界外会被切掉，这是 WPF 自绘弹出层的固定套路。 -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10" CornerRadius="7" Padding="4"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="1.5" Opacity="0.25"
                                              Direction="270" Color="#000000" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单项：最小高 32、左右内边距 10、字号 12；悬停是中性圆角块（Win11 不用强调色实心满框）。
         高亮触发用 IsHighlighted：鼠标悬停和键盘上下键都会置位它，键盘导航同样有高亮反馈。
         勾号列固定 16 宽，勾上或没勾上文字位置都一样，整份菜单才对得齐。 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Item" Margin="0,1" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 勾选标记：用 Path 画勾，不依赖 Segoe MDL2 这类图标字体。
                                 勾号列固定 16 宽，文字位置不受勾选状态影响。 -->
                            <Path x:Name="Check" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Data="M 0,4 L 3,7 L 8,1" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分隔线：1px 细线，左右内缩 8，不顶到卡片边缘 -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource HairlineBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 托盘右键菜单（Win11 飞层菜单观感） =================
         照着 Windows 安全中心那个菜单画的：深灰底、圆角 8、柔和投影、
         没有分隔线、行高 40、字号 14、悬停是一块圆角浅色。
         底色跟边框走 Popup* 画刷，ThemeManager 会按系统明暗改写它们，
         所以系统是深色时菜单就是深色（原生菜单做不到这一点，见 TrayMenu.cs）。 -->

    <Style x:Key="TrayMenuStyle" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- 外留 18 的 Margin 是给投影留的扩散空间：Popup 会裁剪自己的边界，
                         阴影画在边界外会被切掉。 -->
                    <Border Margin="18" CornerRadius="8" Padding="6"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.32"
                                              Direction="270" Color="#000000" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- 悬停块左右各内缩 6，不顶到卡片边缘（Win11 飞层菜单就是这样） -->
                    <Border x:Name="Item" Margin="6,1" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 勾选标记：用 Path 画勾，不依赖 Segoe MDL2 这类图标字体。
                                 勾号列固定 16 宽：勾上或没勾上，文字的起始位置都一样，
                                 整份菜单才对得齐（Win11 的飞层菜单就是这样）。 -->
                            <Path x:Name="Check" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Data="M 0,4 L 3,7 L 8,1" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
