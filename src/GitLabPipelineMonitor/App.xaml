<Application x:Class="GitLabPipelineMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- 托盘应用：关掉所有窗口不能退出，只有右键「退出」才退 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <!-- Widgets.xaml 必须在 Controls.xaml 之前：Controls 里的 FieldInput 用
                     BasedOn 取这里的隐式 TextBox 样式，而 StaticResource 只能找到已加载的字典，
                     顺序放反编译期不报、运行时才抛 XamlParseException -->
                <ResourceDictionary Source="Theme/Widgets.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/TrayMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
